# Local Docker rehearsal. No actual secrets belong in this file.
COMPOSE_PROJECT_NAME=shiftly
IMAGE_TAG=local
POSTGRES_DB=shiftly
POSTGRES_USER=shiftly
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@shiftly.local
# Production: real host/origin, SMTP, certificates and compose.production.yaml.
# HTTPS_PORT=443
# SECURE_HSTS_SECONDS=3600
