# Local development settings. Copy this file to .env.
DEBUG=true
SECRET_KEY=replace-with-a-random-local-development-secret
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Optional while developing. Production must use a dedicated Fernet key for
# encrypted biometric device communication passwords.
# BIOMETRIC_CREDENTIAL_KEY=generate-with-python-cryptography-fernet

# Development defaults to SQLite; leave DATABASE_URL unset.
